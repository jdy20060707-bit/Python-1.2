    print(c)

print("-----3-----")

#0~100 까지의 짝수의 합
sum = 0
for i in range(0, 101):
    if i % 2 == 0:
        sum += i
        print(sum)

print("-----6-----")

#0~100 까지의 짝수의 합_if 없이
sum = 0
for i in range(0, 101, 2):
    sum += i
    print(sum)
