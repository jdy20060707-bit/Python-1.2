#0이 입력될 때까지의 수를 입력받아, 입력 받은 수들의 합과 평균 출력.
a = 1
hap = 0
count = 0

while a!=0:
    a = float(input("숫자를 입력하시오.: "))
    hap = hap + a
    count += 1

    if count > 0:
        print("합: ", hap)
        print("평균: ", hap//count)
    else:
        print("입력된 값이 없습니다.")

